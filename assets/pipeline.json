{
  "schemaVersion": 2,
  "resourceKey": "pipeline.ryan.buyer-qualification-pipeline",
  "storage": {
    "listRef": {"kind":"list","resourceKey":"list.ryan.buyer-qualification-cases"}
  },
  "pipeline": {
    "name": "Buyer Qualification Pipeline",
    "description": "Approval-gated buyer qualification from intake through scored draft and unbooked call suggestions.",
    "columns": [
      {"id":"col_case_id","key":"case_id","label":"Case ID","type":"text","required":true,"order":0},
      {"id":"col_buyer_name","key":"buyer_name","label":"Buyer Name","type":"text","required":true,"order":1},
      {"id":"col_email","key":"email","label":"Email","type":"text","required":true,"order":2},
      {"id":"col_inquiry_summary","key":"inquiry_summary","label":"Inquiry Summary","type":"text","required":true,"order":3},
      {"id":"col_desired","key":"desired","label":"Desired Property","type":"text","required":true,"order":4},
      {"id":"col_budget_min_usd","key":"budget_min_usd","label":"Budget Minimum USD","type":"number","required":true,"order":5},
      {"id":"col_budget_max_usd","key":"budget_max_usd","label":"Budget Maximum USD","type":"number","required":true,"order":6},
      {"id":"col_financing","key":"financing","label":"Financing","type":"text","required":true,"order":7},
      {"id":"col_down_payment_usd","key":"down_payment_usd","label":"Down Payment USD","type":"number","required":false,"order":8},
      {"id":"col_monthly_housing_max_usd","key":"monthly_housing_max_usd","label":"Monthly Housing Maximum USD","type":"number","required":false,"order":9},
      {"id":"col_timeline","key":"timeline","label":"Timeline","type":"text","required":true,"order":10},
      {"id":"col_occupancy","key":"occupancy","label":"Occupancy","type":"text","required":false,"order":11},
      {"id":"col_commute_max_min","key":"commute_max_min","label":"Maximum Commute Minutes","type":"number","required":false,"order":12},
      {"id":"col_fit_score_target","key":"fit_score_target","label":"Fit Score Target","type":"number","required":false,"order":13},
      {"id":"col_fit_band","key":"fit_band","label":"Fit Band","type":"select","required":false,"options":["strong","developing","needs_discovery"],"order":14},
      {"id":"col_next_questions","key":"next_questions","label":"Next Questions","type":"json","required":false,"order":15},
      {"id":"col_draft_response","key":"draft_response","label":"Draft Response","type":"text","required":false,"order":16},
      {"id":"col_suggested_slots","key":"suggested_slots","label":"Suggested Call Slots","type":"json","required":false,"order":17},
      {"id":"col_pipeline_stage","key":"pipeline_stage","label":"Pipeline Stage","type":"select","required":true,"options":["intake","scored","drafted","slots_ready"],"order":18}
    ],
    "stages": [
      {"id":"intake","name":"Intake","type":"initial","triggerKind":"manual","description":"Buyer inquiry captured after the approved Gmail read or deterministic mock fallback.","colorToken":"#64748b","order":0},
      {"id":"scored","name":"Scored","type":"intermediate","triggerKind":"manual","description":"Financing, budget, and comparable values checked; fit score recorded.","colorToken":"#2563eb","order":1},
      {"id":"drafted","name":"Drafted","type":"intermediate","triggerKind":"manual","description":"Unsent response draft with exactly three required questions prepared.","colorToken":"#7c3aed","order":2},
      {"id":"slots_ready","name":"Slots Ready","type":"terminal","triggerKind":"manual","description":"Three unbooked intro-call suggestions prepared.","colorToken":"#16a34a","order":3}
    ],
    "transitions": [
      {
        "id":"score_buyer","name":"Score buyer fit","fromStageId":"intake","toStageId":"scored","trigger":"manual","automation":{"autoFireOnEntry":false},
        "success":{"advanceToStageId":"scored","persistMode":"shared_patch"},
        "failure":{"advanceToStageId":"intake","persistMode":"shared_patch"},
        "failureStageId":"intake","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      },
      {
        "id":"draft_response","name":"Draft buyer response","fromStageId":"scored","toStageId":"drafted","trigger":"manual","automation":{"autoFireOnEntry":false},
        "success":{"advanceToStageId":"drafted","persistMode":"shared_patch"},
        "failure":{"advanceToStageId":"scored","persistMode":"shared_patch"},
        "failureStageId":"scored","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      },
      {
        "id":"prepare_slots","name":"Prepare intro call slots","fromStageId":"drafted","toStageId":"slots_ready","trigger":"manual","automation":{"autoFireOnEntry":false},
        "success":{"advanceToStageId":"slots_ready","persistMode":"shared_patch"},
        "failure":{"advanceToStageId":"drafted","persistMode":"shared_patch"},
        "failureStageId":"drafted","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      }
    ],
    "acquisitionRecipes": [],
    "runConcurrency": "multi"
  },
  "commitMessage": "Repair portable buyer qualification pipeline"
}
