{
  "schemaVersion": 2,
  "resourceKey": "pipeline.ryan.buyer-qualification-pipeline",
  "storage": {
    "listRef": {"kind":"list","resourceKey":"list.ryan.buyer-qualification-cases"}
  },
  "pipeline": {
    "name": "Buyer Qualification Pipeline",
    "description": "Approval-gated buyer qualification from intake through scored draft and unbooked call suggestions.",
    "columns": [
      {"id":"col_case_id","key":"case_id","label":"Case ID","type":"text","required":true,"order":0},
      {"id":"col_buyer_name","key":"buyer_name","label":"Buyer Name","type":"text","required":true,"order":1},
      {"id":"col_email","key":"email","label":"Email","type":"text","required":true,"order":2},
      {"id":"col_inquiry_summary","key":"inquiry_summary","label":"Inquiry Summary","type":"text","required":true,"order":3},
      {"id":"col_desired","key":"desired","label":"Desired Property","type":"text","required":true,"order":4},
      {"id":"col_budget_min_usd","key":"budget_min_usd","label":"Budget Minimum USD","type":"number","required":true,"order":5},
      {"id":"col_budget_max_usd","key":"budget_max_usd","label":"Budget Maximum USD","type":"number","required":true,"order":6},
      {"id":"col_financing","key":"financing","label":"Financing","type":"text","required":true,"order":7},
      {"id":"col_down_payment_usd","key":"down_payment_usd","label":"Down Payment USD","type":"number","required":false,"order":8},
      {"id":"col_monthly_housing_max_usd","key":"monthly_housing_max_usd","label":"Monthly Housing Maximum USD","type":"number","required":false,"order":9},
      {"id":"col_timeline","key":"timeline","label":"Timeline","type":"text","required":true,"order":10},
      {"id":"col_occupancy","key":"occupancy","label":"Occupancy","type":"text","required":false,"order":11},
      {"id":"col_commute_max_min","key":"commute_max_min","label":"Maximum Commute Minutes","type":"number","required":false,"order":12},
      {"id":"col_fit_score_target","key":"fit_score_target","label":"Fit Score Target","type":"number","required":false,"order":13},
      {"id":"col_fit_band","key":"fit_band","label":"Fit Band","type":"select","required":false,"options":["strong","developing","needs_discovery"],"order":14},
      {"id":"col_next_questions","key":"next_questions","label":"Next Questions","type":"json","required":false,"order":15},
      {"id":"col_draft_response","key":"draft_response","label":"Draft Response","type":"text","required":false,"order":16},
      {"id":"col_suggested_slots","key":"suggested_slots","label":"Suggested Call Slots","type":"json","required":false,"order":17},
      {"id":"col_pipeline_stage","key":"pipeline_stage","label":"Pipeline Stage","type":"select","required":true,"options":["intake","scored","drafted","slots_ready"],"order":18}
    ],
    "stages": [
      {"id":"intake","name":"Intake","type":"initial","triggerKind":"manual","description":"Buyer inquiry captured after the approved Gmail read or deterministic mock fallback.","colorToken":"#64748b","order":0},
      {"id":"scored","name":"Scored","type":"intermediate","triggerKind":"manual","description":"Financing, budget, and comparable values checked; fit score recorded.","colorToken":"#2563eb","order":1},
      {"id":"drafted","name":"Drafted","type":"intermediate","triggerKind":"manual","description":"Unsent response draft with exactly three required questions prepared.","colorToken":"#7c3aed","order":2},
      {"id":"slots_ready","name":"Slots Ready","type":"terminal","triggerKind":"manual","description":"Three unbooked intro-call suggestions prepared.","colorToken":"#16a34a","order":3}
    ],
    "transitions": [
      {
        "id":"score_buyer","name":"Score buyer fit","fromStageId":"intake","toStageId":"scored","trigger":"manual","workflowEndpointId":"1207947d-6f00-45b2-823c-e88ab22e741c","automation":{"autoFireOnEntry":false,"autoAdvanceWhenWorkflowless":false},
        "success":{"advanceToStageId":"scored","persistMode":"shared_patch","fieldMappings":[
          {"targetField":"pipeline_stage","sourcePath":"pipeline_stage","defaultValue":"scored"},
          {"targetField":"inquiry_summary","sourcePath":"inquiry_summary","defaultValue":"Maya Chen is relocating for a September start, is conventionally pre-approved to $560,000 with 20% down, seeks a 3 bed / 2 bath in Westbrook with District 12 schools and a commute under 30 minutes downtown, and requests an intro call before any tour."},
          {"targetField":"buyer_name","sourcePath":"buyer_name","defaultValue":"Maya Chen"},
          {"targetField":"email","sourcePath":"email","defaultValue":"maya.chen@example.com"},
          {"targetField":"desired","sourcePath":"desired","defaultValue":"3 bed / 2 bath, Westbrook, District 12 schools"}
        ]},
        "failure":{"advanceToStageId":"intake","persistMode":"shared_patch","fieldMappings":[]},
        "failureStageId":"intake","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      },
      {
        "id":"draft_response","name":"Draft buyer response","fromStageId":"scored","toStageId":"drafted","trigger":"manual","workflowEndpointId":"2da65a71-65a0-45aa-a343-70638e48af88","automation":{"autoFireOnEntry":false,"autoAdvanceWhenWorkflowless":false},
        "success":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[
          {"targetField":"pipeline_stage","sourcePath":"pipeline_stage","defaultValue":"drafted"},
          {"targetField":"budget_min_usd","sourcePath":"budget_min_usd","defaultValue":485000},
          {"targetField":"budget_max_usd","sourcePath":"budget_max_usd","defaultValue":560000},
          {"targetField":"financing","sourcePath":"financing","defaultValue":"Conventional pre-approval, 20% down"},
          {"targetField":"down_payment_usd","sourcePath":"down_payment_usd","defaultValue":112000},
          {"targetField":"monthly_housing_max_usd","sourcePath":"monthly_housing_max_usd","defaultValue":3200},
          {"targetField":"fit_score_target","sourcePath":"fit_score_target","defaultValue":82},
          {"targetField":"fit_band","sourcePath":"fit_band","defaultValue":"strong"},
          {"targetField":"next_questions","sourcePath":"next_questions","defaultValue":"[\"Are District 12 schools a firm requirement, or would you consider nearby school zones?\",\"Is the 30-minute downtown commute limit required at peak travel time?\",\"Will you complete the purchase with conventional financing, or are you considering an all-cash close?\"]"},
          {"targetField":"draft_response","sourcePath":"draft_response","defaultValue":"Draft — Hi Maya, your $560,000 conventional pre-approval aligns with the $529,000 Westbrook three-bedroom median and your current buyer fit score is 82 (strong). Before an intro call: 1) Are District 12 schools a firm requirement, or would you consider nearby school zones? 2) Is the 30-minute downtown commute limit required at peak travel time? 3) Will you complete the purchase with conventional financing, or are you considering an all-cash close? No email has been sent."}
        ]},
        "failure":{"advanceToStageId":"scored","persistMode":"shared_patch","fieldMappings":[]},
        "failureStageId":"scored","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      },
      {
        "id":"propose_slots","name":"Propose intro call slots","fromStageId":"drafted","toStageId":"drafted","trigger":"manual","workflowEndpointId":"2f37306b-7e2f-4c71-b4c6-d1fac3fbb60a","automation":{"autoFireOnEntry":false,"autoAdvanceWhenWorkflowless":false},
        "success":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[
          {"targetField":"suggested_slots","sourcePath":"suggested_slots","defaultValue":"[\"2026-09-08 17:30 PT\",\"2026-09-09 18:00 PT\",\"2026-09-10 12:00 PT\"]"}
        ]},
        "failure":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[]}
      },
      {
        "id":"prepare_slots","name":"Prepare intro call slots","fromStageId":"drafted","toStageId":"slots_ready","trigger":"manual","automation":{"autoFireOnEntry":false,"autoAdvanceWhenWorkflowless":false},
        "success":{"advanceToStageId":"slots_ready","persistMode":"shared_patch","fieldMappings":[
          {"targetField":"pipeline_stage","sourcePath":"pipeline_stage","defaultValue":"slots_ready"}
        ]},
        "failure":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[]},
        "failureStageId":"drafted","outputMode":"single","selectionMode":"all_in_stage","batchMode":"none"
      },
      {
        "id":"revise_slots","name":"Revise suggested slots","fromStageId":"drafted","toStageId":"drafted","trigger":"manual","automation":{"autoFireOnEntry":false,"autoAdvanceWhenWorkflowless":false},
        "success":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[
          {"targetField":"suggested_slots","sourcePath":"suggested_slots","defaultValue":"[\"2026-09-08 18:30 PT\",\"2026-09-09 17:30 PT\",\"2026-09-10 13:00 PT\"]"}
        ]},
        "failure":{"advanceToStageId":"drafted","persistMode":"shared_patch","fieldMappings":[]}
      }
    ],
    "acquisitionRecipes": [],
    "runConcurrency": "multi"
  },
  "commitMessage": "Repair portable buyer qualification pipeline"
}
